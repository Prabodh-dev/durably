# Copy to .env and adjust. Every value here is a placeholder or a local
# development default. No real credentials belong in this file.

# ---------------------------------------------------------------------------
# Required by both the API server and the worker
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://durably:durably@localhost:15432/durably

# ---------------------------------------------------------------------------
# API server (packages/server)
# ---------------------------------------------------------------------------
# Port the HTTP API listens on.
PORT=3000
# pino level for every process: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info
# Bearer key required on /v1/admin routes. Leave empty to disable that route
# group entirely, which is the default for local development.
DURABLY_ADMIN_KEY=
# When true, every /v1 route needs a tenant API key. Without a key the request
# is treated as the default tenant. Default false.
DURABLY_REQUIRE_API_KEY=false
# Statement timeout applied to every pooled connection, in milliseconds. A
# database that accepts a query and never answers would otherwise hang a
# process forever. Default 30000.
DURABLY_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Worker (packages/worker)
# ---------------------------------------------------------------------------
# Defaults to a random id when unset.
DURABLY_WORKER_ID=
# Steps this worker runs at once. Default 4.
DURABLY_WORKER_CONCURRENCY=4
# How long a claim is valid before the reaper may hand the task to someone
# else. Must exceed the longest expected step. Default 15000.
DURABLY_WORKER_LEASE_MS=15000
# Idle poll interval used when a task_ready notification has not arrived.
# Default 1000.
DURABLY_WORKER_POLL_INTERVAL_MS=200
# Set to false to run without advisory lock leadership, which also disables the
# lease reaper, stuck run repair, and cron ticking. Default true.
DURABLY_WORKER_LEADER=true
# How often leadership is re-attempted. Default 2000.
DURABLY_WORKER_LEADER_INTERVAL_MS=2000
# Lease reaper interval. Default 1000.
DURABLY_WORKER_REAPER_INTERVAL_MS=1000
# Stuck run sweep interval. Default 10000.
DURABLY_WORKER_STUCK_RUN_INTERVAL_MS=10000
# Cron ticker interval. Default 1000.
DURABLY_WORKER_CRON_INTERVAL_MS=1000
# Prometheus endpoint port for this worker. 0 disables it. Default 0.
DURABLY_WORKER_METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Tracing stays off until one of these is set. Either the traces endpoint or
# the generic OTLP endpoint is read.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard)
# ---------------------------------------------------------------------------
DURABLY_API_URL=http://localhost:3000
DURABLY_API_KEY=

# ---------------------------------------------------------------------------
# Sample workflow in packages/worker/src/workflows.ts
# ---------------------------------------------------------------------------
# Probability that the maybe-fail step throws, used to show retries. Default
# 0.35.
ONBOARD_USER_FAILURE_RATE=0.35

# ---------------------------------------------------------------------------
# Scripts
# ---------------------------------------------------------------------------
# scripts/demo-crash.mjs
DEMO_IDEMPOTENCY_KEY=
# scripts/bench.mjs
BENCH_RUNS=500
BENCH_WORKERS=2
BENCH_CONCURRENCY=8
BENCH_METRICS_PORT=9401
BENCH_TIMEOUT_MS=600000
# scripts/queue-model.mjs
QUEUE_TENANTS=4
QUEUE_TASKS_PER_TENANT=250
QUEUE_CLAIMERS=8
QUEUE_BATCH=10
QUEUE_LEASE_MS=15000
QUEUE_TIMEOUT_MS=300000
# Test harness only, used by packages/core/test/chaos.test.ts
DURABLY_CHAOS_STEP_DELAY_MS=8000
